#. module: pan_style_pro_search
#. odoo-python
#: code:addons/pan_style_pro_search/models/base.py:0
#: model:res.groups,name:pan_style_pro_search.group_smart_search
msgid "Smart search"
msgstr "Slim zoeken"

#. module: pan_style_pro_search
#: model:ir.model.fields,field_description:pan_style_pro_search.field_res_config_settings__group_pan_smart_search
msgid "Use smart search"
msgstr "Slim zoeken gebruiken"

#. module: pan_style_pro_search
#: model:ir.model.fields,help:pan_style_pro_search.field_res_config_settings__group_pan_smart_search
msgid ""
"Search with separate words in any order, tolerant of typos, best match "
"first. Applies to every search bar, search dialog and dropdown."
msgstr ""
"Zoek met losse woorden in elke volgorde, ook met typfouten, beste match "
"bovenaan. Geldt voor elke zoekbalk, elk zoekvenster en elke dropdown."

#. module: pan_style_pro_search
#: model_terms:ir.ui.view,arch_db:pan_style_pro_search.res_config_settings_view_form
msgid "Search"
msgstr "Zoeken"

#. module: pan_style_pro_search
#: model_terms:ir.ui.view,arch_db:pan_style_pro_search.res_config_settings_view_form
msgid ""
"Search everywhere with separate words in any order, tolerant of typos,\n"
"                                best match first. The standard search fields and filters stay."
msgstr ""
"Zoek overal met losse woorden in elke volgorde, ook met typfouten,\n"
"                                beste match bovenaan. De standaard zoekvelden en filters blijven."

#. module: pan_style_pro_search
#: model:res.groups,comment:pan_style_pro_search.group_smart_search
msgid "Search bars and dropdowns use smart search. Managed by Settings > Style Pro."
msgstr "Zoekbalken en dropdowns gebruiken slim zoeken. Beheerd via Instellingen > Style Pro."

#. module: pan_style_pro_search
#: model:ir.cron,cron_name:pan_style_pro_search.ir_cron_smart_search_indexes
msgid "Smart search: trigram indexes on large tables"
msgstr "Slim zoeken: trigram-indexen op grote tabellen"
