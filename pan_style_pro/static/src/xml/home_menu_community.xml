<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <!-- HomeMenuCommunity component template -->
    <t t-name="pan_style_pro.HomeMenuCommunity">
        <div class="o_home_menu h-100 overflow-auto">
            <div class="pan-home-menu-container mx-auto">
                <!-- Off-screen field that captures typing on the home menu. Password
                     managers see a lone focused text input and pop their autofill
                     menu over the page. type="search" is what Bitwarden skips
                     unconditionally (data-bwignore is opt-in per user); the data-*
                     attributes cover the other managers. -->
                <input t-ref="this.inputRef" type="search" class="visually-hidden" t-on-input="this._onInputSearch"
                       name="pan_home_menu_search" aria-label="Type to search apps"
                       autocomplete="off" data-allow-hotkeys="true"
                       data-bwignore="true" data-1p-ignore="true" data-lpignore="true"
                       data-form-type="other"/>

                <!-- Search bar -->
                <div class="pan-home-search mx-auto mb-4">
                    <div class="pan-home-search-box d-flex align-items-center"
                         t-on-click="() => this.command.openMainPalette({ searchValue: '/' })">
                        <i class="oi me-2 opacity-50" data-icon="search"/>
                        <span class="opacity-50">Search</span>
                    </div>
                </div>

                <!-- Visible app grid -->
                <div class="pan-home-apps" t-ref="this.rootRef">
                    <t t-foreach="this.visibleApps" t-as="app" t-key="app.id">
                        <div class="o_draggable">
                            <a class="pan-home-app"
                               t-att-class="{ 'o_focused': this.state.focusedIndex === app_index }"
                               t-att-href="this.getMenuItemHref(app)"
                               t-att-data-menu-xmlid="app.xmlid"
                               t-on-click.prevent="() => this._openApp(app)"
                               t-on-contextmenu="(ev) => this.onAppContextMenu(app, ev)">
                                <img t-if="app.webIconData" t-att-src="app.webIconData"
                                     class="pan-home-app-icon" alt=""/>
                                <div t-else="" class="pan-home-app-icon pan-home-app-icon-placeholder">
                                    <i class="oi" data-icon="deployed_code"/>
                                </div>
                                <span class="pan-home-app-name" t-out="app.name"/>
                            </a>
                        </div>
                    </t>
                </div>

                <!-- Hidden apps toggle -->
                <div t-if="this.hiddenApps.length" class="pan-hidden-apps-toggle">
                    <button class="pan-hidden-apps-btn" t-on-click="this.toggleHiddenApps">
                        <i class="oi me-2" t-att-data-icon="this.state.showHiddenApps ? 'visibility' : 'visibility_off'"/>
                        <span t-out="this.hiddenApps.length"/>
                        <span class="ms-1">hidden app(s)</span>
                        <i class="oi ms-2" t-att-data-icon="this.state.showHiddenApps ? 'keyboard_arrow_up' : 'keyboard_arrow_down'"/>
                    </button>
                </div>

                <!-- Hidden apps grid (dimmed) -->
                <div t-if="this.hiddenApps.length and this.state.showHiddenApps" class="pan-home-apps pan-home-apps-hidden">
                    <t t-foreach="this.hiddenApps" t-as="app" t-key="app.id">
                        <div class="pan-home-app pan-home-app-dimmed">
                            <div class="pan-home-app-icon-wrapper">
                                <img t-if="app.webIconData" t-att-src="app.webIconData"
                                     class="pan-home-app-icon" alt=""/>
                                <div t-else="" class="pan-home-app-icon pan-home-app-icon-placeholder">
                                    <i class="oi" data-icon="deployed_code"/>
                                </div>
                                <button class="pan-unhide-btn" t-on-click="() => this.showApp(app)"
                                        title="Show app">
                                    <i class="oi" data-icon="visibility"/>
                                </button>
                            </div>
                            <span class="pan-home-app-name" t-out="app.name"/>
                        </div>
                    </t>
                </div>

                <!-- Context menu -->
                <div t-if="this.state.contextMenu.visible" class="pan-context-menu"
                     t-attf-style="left: {{ this.state.contextMenu.x }}px; top: {{ this.state.contextMenu.y }}px;">
                    <button class="pan-context-menu-item" t-on-click="() => this.hideApp(this.state.contextMenu.app)">
                        <i class="oi me-2" data-icon="visibility_off"/>Hide app
                    </button>
                </div>
            </div>
        </div>
    </t>

    <!-- Override NavBar.AppsMenu: replace Dropdown with grid icon that toggles home menu service -->
    <t t-name="pan_style_pro.AppsMenuCommunity" t-inherit="web.NavBar.AppsMenu" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_navbar_apps_menu')]/Dropdown" position="replace">
            <button class="o_menu_toggle border-0 bg-transparent" title="Home Menu"
                    t-on-click.prevent="() => this.env.services['home_menu'] &amp;&amp; this.env.services['home_menu'].toggle()">
                <i class="oi" data-icon="apps"/>
            </button>
        </xpath>
    </t>

</templates>
