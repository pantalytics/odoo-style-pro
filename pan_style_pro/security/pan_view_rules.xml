<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- A user sees and edits only their own views. -->
    <record id="pan_view_rule_own" model="ir.rule">
        <field name="name">Personal view: own rows only</field>
        <field name="model_id" ref="model_pan_view"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <!-- Administrators can inspect and clean up everyone's views. -->
    <record id="pan_view_rule_admin" model="ir.rule">
        <field name="name">Personal view: administrators see all</field>
        <field name="model_id" ref="model_pan_view"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
